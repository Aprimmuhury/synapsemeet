# Copy this file to .env and fill in real values.
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver,10.0.2.2,10.0.3.2

# Database: keep sqlite for local development, or use Google Cloud SQL.
# For Cloud SQL PostgreSQL set DB_ENGINE=cloudsql and fill these values.
DB_ENGINE=sqlite
DB_NAME=synapsemeet
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# SynapseMeet's AI features call out to an LLM provider. Plug in a real
# key here, then wire it up in ai_assistant/services.py
AI_PROVIDER=anthropic
AI_API_KEY=your-api-key-here

# Used to build links in emails (password reset, etc.)
FRONTEND_BASE_URL=http://127.0.0.1:5500
DEFAULT_FROM_EMAIL=noreply@synapsemeet.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Render / production deployment values (example) ---
# SECRET_KEY=<generate a real 50-char random string>
# DEBUG=False
# ALLOWED_HOSTS=synapsemeet.onrender.com
# DB_ENGINE=postgres
# DB_NAME=<from Render Postgres dashboard>
# DB_USER=<from Render Postgres dashboard>
# DB_PASSWORD=<from Render Postgres dashboard>
# DB_HOST=<from Render Postgres dashboard, Internal Host>
# DB_PORT=5432
# DB_SSLMODE=require
# FRONTEND_BASE_URL=https://synapsemeet.onrender.com
